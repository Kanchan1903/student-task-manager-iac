# ============================================================
# .gitignore
# Files that must NOT be committed to GitHub.
# ============================================================

# ── Terraform state files (may contain sensitive infrastructure data) ──
*.tfstate
*.tfstate.*
*.tfstate.backup

# ── Terraform working directory (auto-generated, not source code) ──
.terraform/

# ── Actual variable values file (contains your account ID) ──
# The .example version IS committed; the real values file is NOT.
terraform.tfvars

# ── Crash logs ──
crash.log
crash.*.log

# ── Override files (not standard practice to commit) ──
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# ── Sensitive environment files ──
.env
.env.*
!.env.example

# ── API Tokens / Keys / Secrets ──
*.pem
*.key
secrets.json

# ── OS generated files ──
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ── Editor directories ──
.vscode/
.idea/
*.swp
*.swo
*~

# ── Node (if any tooling is added later) ──
node_modules/

# ── Logs ──
*.log
